<div class="card text-bg-dark h-25">
  <img class='opacity-25' src="<%= article.image %>" class="card-img" alt="<%= article.title %>">
  <div class="card-img-overlay d-flex flex-column flex-md-column justify-content-center">
    <p class='datecard-text fs-6'>
      <%= article.date %>
    </p>
    <p class="card-text fs-6">
      <%= article.title %>
    </p>
    <a class='card-text text-white text-decoration-none' href='<%= article.link || "#" %>'>VIEW DETAILS</a>
  </div>
</div>